@startuml AI_Present_Finder_Use_Cases

!define LIGHTBLUE #E3F2FD
!define BLUE #2196F3

skinparam actor {
    BackgroundColor LIGHTBLUE
    BorderColor BLUE
}

skinparam usecase {
    BackgroundColor LIGHTBLUE
    BorderColor BLUE
}

left to right direction

actor "Użytkownik" as User
actor "Administrator" as Admin

rectangle "AI Present Finder" {
    usecase "Szukanie prezentu" as UC1
    usecase "Dodanie prezentu\ndo ulubionych" as UC2
    usecase "Logowanie przez Google" as UC3
    usecase "Wystaw opinię" as UC4
    usecase "Doprecyzuj wyszukiwanie" as UC5
    usecase "Pobierz informacje\no opiniach" as UC6
    usecase "Filtrowanie wyników" as UC7
}

' User relationships
User -- UC1
User -- UC2
User -- UC3
User -- UC4
User -- UC5

' Admin relationships
Admin -- UC6

' Relationships
UC7 .> UC1 : <<extend>>

@enduml
